# ============================================================================
# Self-Hosted Docker / OCI Deployment Configuration
# Copy to .env and fill in the required values before running:
#   cp .env.docker.example .env
#   docker compose up -d --build
# ============================================================================

# --- Self-Hosted Infrastructure ---
DATABASE_DRIVER=postgres
POSTGRES_USER=aiworkflow
POSTGRES_PASSWORD=aiworkflow
POSTGRES_DB=aiworkflow
DATABASE_URL=postgresql://aiworkflow:aiworkflow@postgres:5432/aiworkflow

SANDBOX_KIND=docker
DOCKER_SANDBOX_IMAGE=ai-workflow-sandbox:latest
CRON_IN_PROCESS=true
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-hex-secret

# --- Public Origins & Dashboard Auth (REQUIRED) ---
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-character-secret
# Public URL where the worker is reachable (used for webhooks & auth):
BETTER_AUTH_URL=http://localhost:3000
# Public URL where the dashboard is reachable in your browser:
DASHBOARD_ORIGIN=http://localhost:3001
# Internal Docker network URL for the dashboard BFF to reach the worker:
WORKER_INTERNAL_URL=http://worker:3000

# Initial Dashboard Admin Owner (seeded automatically at container startup):
DASHBOARD_AUTH_EMAIL=admin@example.com
DASHBOARD_AUTH_PASSWORD=ChangeMe123!
DASHBOARD_ORG_SLUG=ai-workflow

# Encryption keys (optional, 64 hex chars each: `openssl rand -hex 32`)
# INTEGRATION_SECRETS_KEY=
# WEBHOOK_TRIGGER_ENCRYPTION_KEY=

# --- Agent Credentials (at least one provider required for runs) ---
ANTHROPIC_API_KEY=
# CODEX_API_KEY=
# CODEX_CHATGPT_OAUTH_TOKEN=

# --- Integrations (can also be connected from the Dashboard UI if INTEGRATION_SECRETS_KEY is set) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=PROJ
# JIRA_WEBHOOK_SECRET=

# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_INSTALLATION_ID=
# GITHUB_WEBHOOK_SECRET=
